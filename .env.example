# Required: Instagram Graph API long-lived access token
INSTAGRAM_ACCESS_TOKEN=

# Required: Instagram professional account ID (IG user ID)
INSTAGRAM_ACCOUNT_ID=

# Optional: Graph API host (default: https://graph.facebook.com)
# Use https://graph.instagram.com for Instagram Login tokens
# INSTAGRAM_GRAPH_API_BASE=https://graph.facebook.com

# Optional: Graph API version (default: v22.0)
# INSTAGRAM_API_VERSION=v22.0

# Optional: HTTP port (default: 3000). Hosting platforms usually set PORT.
# PORT=3000

# Optional: Bearer token required by clients calling /mcp (recommended for public deploys)
# MCP_AUTH_TOKEN=
